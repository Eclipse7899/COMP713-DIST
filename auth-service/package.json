{
  "name": "auth-service",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "test": "bun test --timeout 30000",
    "build:image": "docker build -t auth-service:latest -f Dockerfile ..",
    "build:init-image": "docker build -t auth-db-init:latest -f init.Dockerfile ..",
    "test:watch": "bun test --watch --timeout 30000",
    "test:coverage": "bun test --coverage --timeout 30000",
    "prisma:generate": "prisma generate --no-hints",
    "prisma:migrate-dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset",
    "proto:generate": "mkdir -p src/generated/proto && protoc --ts_proto_out=src/generated/proto --ts_proto_opt=outputServices=grpc-js,env=node,outputClientImpl=false,outputServerImpl=true,oneof=unions --proto_path=../proto ../proto/auth.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.6.0",
    "@prisma/adapter-pg": "^7.9.1",
    "dotenv": "^18.0.7",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "prisma": "^7.9.1",
    "ts-proto": "^2.13.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
