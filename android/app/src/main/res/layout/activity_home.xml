<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stocked_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🥛  Stocked"
            android:textColor="@color/stocked_heading"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Welcome -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Welcome"
            android:textColor="@color/stocked_heading"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Here's what's in your pantry."
            android:textColor="@color/stocked_secondary"
            android:textSize="15sp" />

        <!-- Pantry heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Your pantry"
            android:textColor="@color/stocked_heading"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Refresh button -->
        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refresh"
            android:textAllCaps="false"
            android:backgroundTint="@color/stocked_primary"
            android:textColor="@android:color/white" />

        <!-- Pantry card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/login_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/pantryStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="Pantry items will appear here"
                android:textColor="@color/stocked_secondary"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>