<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stocked_background"
    android:fillViewport="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textColor="@color/stocked_heading"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Welcome -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/welcome"
            android:textColor="@color/stocked_heading"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pantry_subtitle"
            android:textColor="@color/stocked_secondary"
            android:textSize="15sp" />

        <!-- Pantry heading and refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/your_pantry"
                android:textColor="@color/stocked_heading"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:contentDescription="@string/refresh"
                android:scaleType="centerInside"
                android:padding="12dp"
                app:tint="@color/stocked_heading" />
        </LinearLayout>

        <!-- Add Item button -->
        <Button
            android:id="@+id/addItemNavButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/add_item"
            android:textAllCaps="false"
            android:backgroundTint="@color/stocked_primary"
            android:textColor="@android:color/white" />




        <!-- Pantry card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/login_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/pantryStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/pantry_placeholder"
                android:textColor="@color/stocked_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/pantryItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="0dp" />


        </LinearLayout>

    </LinearLayout>

</ScrollView>