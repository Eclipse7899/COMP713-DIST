{
  "name": "@stocked/shared",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch --timeout 30000",
    "test:coverage": "bun test --coverage --timeout 30000",
    "prisma:generate": "prisma generate --no-hints",
    "prisma:migrate-dev": "prisma migrate dev",
    "proto:generate": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto.exe --ts_proto_out=src/generated/proto --ts_proto_opt=outputServices=grpc-js --ts_proto_opt=esModuleInterop=true --ts_proto_opt=oneof=unions -I=../proto ../proto/auth.proto",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "prisma": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ts-proto": "^2.13.0",
    "bcryptjs": "^3.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.5",
    "@types/bun": "latest",
    "dotenv": "^17.4.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
