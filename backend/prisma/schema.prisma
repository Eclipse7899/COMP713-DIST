// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model FoodItem {
  id         String    @id @default(cuid(2))
  userId     String
  foodId     String
  quantity   Float     @default(1)
  unit       FoodUnit  @default(ITEM)
  expiryDate DateTime?
  addedAt    DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiryDate])
}

model User {
  id         String      @id @default(cuid(2))
  foodItems  FoodItem[]
  sharedWithOthers UserShare[] @relation("UserSharedOwner")
  sharedWithMe   UserShare[] @relation("UserSharedWith")
  foods     Food[]
  wsTickets WsTicket[]
}

model WsTicket {
  ticket    String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserShare {
  userId     String
  sharedWithUserId String
  sharedAt   DateTime @default(now())

  user User @relation("UserSharedOwner", fields: [userId], references: [id], onDelete: Cascade)
  sharedUser User @relation("UserSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@id([userId, sharedWithUserId])
  @@index([userId])
  @@index([sharedWithUserId])
}

model Food {
  id              String       @id @default(cuid(2))
  name            String
  category        FoodCategory
  createdByUserId String?
  createdAt       DateTime     @default(now())
  foodItems       FoodItem[]

  user User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  @@index([createdByUserId])
}

enum FoodCategory {
  FRUIT
  VEGETABLE
  MEAT
  DAIRY
  GRAINS
  DRINKS
  SNACKS
  SAUCES
  FROZEN
  OTHER
}

enum FoodUnit {
  ITEM
  KG
  G
  L
  ML
  PACK
}
