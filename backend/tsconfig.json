{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "module": "ESNext",
    "target": "ESNext",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
