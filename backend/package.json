{
  "name": "@stocked/backend",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build:image": "docker build -t backend:latest -f Dockerfile ..",
    "build:init-image": "docker build -t backend-db-init:latest -f init.Dockerfile ..",
    "openapi:generate": "bun run scripts/generateOpenapi.ts",
    "prisma:generate": "prisma generate --no-hints",
    "prisma:migrate-dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset",
    "proto:generate": "mkdir -p src/generated/proto && protoc --ts_proto_out=src/generated/proto --ts_proto_opt=outputServices=grpc-js,env=node,outputClientImpl=true,outputServerImpl=false,oneof=unions --proto_path=../proto ../proto/auth.proto",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch --timeout 30000",
    "test:coverage": "bun test --coverage --timeout 30000"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@grpc/grpc-js": "^1.14.5",
    "@hono/bun": "^1.0.0",
    "@hono/zod-validator": "^0.9.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "hono": "^4.13.3",
    "hono-openapi": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "^1.4.0",
    "dotenv": "^18.0.7",
    "prisma": "^7.9.1",
    "testcontainers": "^12.1.0",
    "ts-proto": "^2.13.0",
    "typescript": "^7.0.2"
  }
}
