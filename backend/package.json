{
  "name": "@stocked/backend",
  "prisma": {
    "schema": "../shared/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "openapi:generate": "bun run scripts/generateOpenapi.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch --timeout 30000",
    "test:coverage": "bun test --coverage --timeout 30000"
  },
  "dependencies": {
    "@hono/bun": "^1.0.0",
    "@hono/zod-validator": "^0.9.0",
    "@grpc/grpc-js": "^1.14.5",
    "@stocked/shared": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "hono": "^4.13.3",
    "hono-openapi": "^1.3.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "testcontainers": "^12.1.0"
  }
}
